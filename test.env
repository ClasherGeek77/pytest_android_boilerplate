# settings for run_test.sh, the tests read them through lib/constants.py
SERVER_URL=http://127.0.0.1:4723
APP_PACKAGE=com.ted.ted_mobile_app_test
APP_ACTIVITY=com.ted.ted_mobile_app_test.MainActivity
AVD_NAME=android9
UI_TIMEOUT=20          # seconds a normal wait accepts
NEW_COMMAND_TIMEOUT=300
# where your tools live; the defaults below are the macOS ones, uncomment and edit if yours differ
# ANDROID_HOME_DIR=~/Library/Android/sdk
# JAVA_HOME_8=/path/to/a/jdk8/home
# APPIUM_BIN=/path/to/appium    # found on PATH or in ~/.local/bin when unset
# flutter draws everything in one view: without an accessibility service
# the uiautomator2 tree is empty, this tiny enabler makes the app publish
# its widgets as content-desc nodes, see the README "why an enabler apk"
# ENABLER_APK=apps/a11y-enabler.apk       fetched by ./fetch_app.sh
ENABLER_ID=net.ted.a11yenabler/.Enabler
# APK_TO_INSTALL=apps/ted_mobile_app_test-v1.0.0-debug.apk   fetched by ./fetch_app.sh
